{
	"schemaVersion": 1,
	"id": "aidiary",
	"version": "${version}",
	"name": "AI Diary",
	"description": "record fancy diary for your Minecraft story!",
	"authors": [
		"datsuns"
	],
	"contact": {
		"homepage": "https://github.com/datsuns/mc-ai-diary",
		"sources": "https://github.com/datsuns/mc-ai-diary"
	},
	"license": "CC0-1.0",
	"icon": "assets/aidiary/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.datsuns.aidiary.AIDiary"
		],
		"client": [
			"me.datsuns.aidiary.AIDiaryClient"
		]
	},
	"mixins": [
		"ai-diary.mixins.json",
		{
			"config": "ai-diary.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*",
		"cloth-config": "*"
	}
}
